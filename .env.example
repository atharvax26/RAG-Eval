# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# ScaleDown
SCALEDOWN_API_KEY=your_scaledown_api_key_here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:rageval123@db:5432/rageval
DATABASE_URL_SYNC=postgresql://postgres:rageval123@db:5432/rageval

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=rageval_

# App
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
EMBEDDING_MODEL=models/text-embedding-004
GENERATION_MODEL=gemini-1.5-flash
EMBED_DIM=768
